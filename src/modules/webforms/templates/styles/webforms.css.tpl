.webforms_editor_add_buttons {
    overflow-y: auto;
    margin-bottom: 15px;
}

.webforms_editor_form_fields {
    clear: both;
    margin-top: 15px;
    overflow-y: auto;
}

.selected_webforms {
    clear: both;
    margin-top: 15px;
    overflow-y: auto;
}

.webforms_editor_form_fields .draggable_wrapper,
.selected_webforms .draggable_wrapper {
    margin-bottom: var(--spacing-md);
}

.webform_drag_placeholder {
    background: var(--color-gray-100);
    border: 2px dashed var(--color-gray-400);
    border-radius: 6px;
    box-sizing: border-box;
    margin-bottom: var(--spacing-md);
}

/* Webforms list uses generic content_left_column styling */

.form_field_editor_wrapper textarea {
    width: 100%;
}